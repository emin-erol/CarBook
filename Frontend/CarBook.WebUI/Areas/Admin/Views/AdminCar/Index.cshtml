@model List<ResultCarWithBrandsDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Araç Listesi</h4>
                        <p class="card-subtitle mb-4">
                            Arabalarla ilgili ekleme, silme, güncelleme arama ve listeleme gibi işlemleri
                            bu sayfa üzerinden gerçekleştirebilirsiniz.
                        </p>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Marka</th>
                                        <th>Model</th>
                                        <th>Vites Türü</th>
                                        <th>Kilometre</th>
                                        <th style="width:1px"></th>
                                        <th style="width:1px"></th>
                                        <th style="width:1px"></th>
                                        <th style="width:1px"></th>
                                        <th style="width:1px"></th>
                                        <th style="width:1px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td>@item.BrandName</td>
                                            <td>@item.Model</td>
                                            <td>@item.Transmission</td>
                                            <td>@item.Mileage</td>
                                            <td>
                                                <a href="/AdminCar/RemoveCar/@item.CarId" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                                </td>
                                            <td>
                                                <a href="/AdminCar/UpdateCar/@item.CarId" class="btn btn-sm btn-info">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="/Admin/AdminCarFeatureDetail/Index/@item.CarId" class="btn btn-sm btn-dark">
                                                    <i class="fas fa-ellipsis-h"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="/Admin/AdminCarFeatureDetail/CreateCarFeatureByCar" class="btn btn-sm btn-info">
                                                    <i class="fa-solid fa-plus"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-warning">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-success" >
                                                    <i class="fa-solid fa-money-bill-1"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <a href="/AdminCar/CreateCar/" class="btn btn-outline-primary">Yeni Araç Ekle</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
